{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home Media",
  "version": "0.1.0",
  "identifier": "ca.razeddeveloper.homemedia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web-resource",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Home Media",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset: http://127.0.0.1:8765; img-src 'self' asset: http://127.0.0.1:8765 data: blob:; media-src 'self' http://127.0.0.1:8765 blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": {
      "web/": "web/"
    }
  }
}
